# systemd-Dienst für s5io (E/A-Dienst für S5Sim)
#
#   sudo cp s5io/s5io.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now s5io
#   journalctl -u s5io -f          # Meldungen ansehen
[Unit]
Description=s5io - E/A-Dienst für S5Sim
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/s5io --port 2511
Restart=on-failure
RestartSec=2

# eigener, unprivilegierter Benutzer mit Zugriff auf /dev/gpiochip*
DynamicUser=yes
SupplementaryGroups=gpio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
