; =====================================================================
;  Fußgängerampel als Schrittkette
;  E 0.0 = Anforderungstaster (Eingabekarte: Rechtsklick → Taster statt Schalter)
;  Auto:       A 0.0 rot   A 0.1 gelb   A 0.2 grün
;  Fußgänger:  A 1.0 rot   A 1.1 grün
;  Schritte:   M 10.0 .. M 10.3
; =====================================================================

OB 21
; Neuanlauf: Grundstellung = Schritt 0
; VKE 1 bilden (Merker ist im Neuanlauf ohnehin 0)
:UN M 10.0
:ON M 10.0
:S  M 10.0
:BE

OB 1
:SPA PB 1           ; Schrittkette
:SPA PB 2           ; Ausgänge
:BE

PB 1
; --- Grundstellung, falls kein Schritt aktiv ist
:UN M 10.0
:UN M 10.1
:UN M 10.2
:UN M 10.3
:S  M 10.0
***
; --- Schritt 0 -> 1: Anforderung
:U  M 10.0
:U  E 0.0
:S  M 10.1
:R  M 10.0
***
; --- Schritt 1: Auto gelb, 3 s
:U  M 10.1
:L  KT 030.1
:SE T 1
:U  M 10.1
:U  T 1
:S  M 10.2
:R  M 10.1
***
; --- Schritt 2: Fußgänger grün, 8 s
:U  M 10.2
:L  KT 080.1
:SE T 2
:U  M 10.2
:U  T 2
:S  M 10.3
:R  M 10.2
***
; --- Schritt 3: Auto rot-gelb, 2 s
:U  M 10.3
:L  KT 020.1
:SE T 3
:U  M 10.3
:U  T 3
:S  M 10.0
:R  M 10.3
:BE

PB 2
; --- Auto grün in Schritt 0
:U  M 10.0
:=  A 0.2
; --- Auto gelb in Schritt 1 und 3
:O  M 10.1
:O  M 10.3
:=  A 0.1
; --- Auto rot in Schritt 2 und 3
:O  M 10.2
:O  M 10.3
:=  A 0.0
; --- Fußgänger
:U  M 10.2
:=  A 1.1
:UN M 10.2
:=  A 1.0
:BE
